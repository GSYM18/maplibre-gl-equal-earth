{
  "name": "@yellowmap/maplibre-gl-equal-earth",
  "version": "1.0.0-alpha.1",
  "type": "module",
  "description": "Equal Earth projection for MapLibre GL JS — a polyfill for the pending style-spec projection values.",
  "keywords": [
    "maplibre",
    "maplibre-gl-js",
    "plugin",
    "projection",
    "equal-earth",
    "equal-area",
    "cartography"
  ],
  "license": "MIT",
  "author": "YellowMap",
  "contributors": [
    "Pirmin Kalberer (original maplibre-gl-equal-earth)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GSYM18/maplibre-gl-equal-earth.git"
  },
  "bugs": {
    "url": "https://github.com/GSYM18/maplibre-gl-equal-earth/issues"
  },
  "homepage": "https://github.com/GSYM18/maplibre-gl-equal-earth#readme",
  "sideEffects": ["./dist/worker.mjs", "./dist/worker.iife.js"],
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/tiles/worker-entry.d.ts",
      "import": "./dist/worker.mjs",
      "default": "./dist/worker.mjs"
    },
    "./worker.iife.js": "./dist/worker.iife.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:js && npm run build:types",
    "build:js": "vite build && vite build --config vite.worker.config.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "check:exports": "node scripts/check-exports.mjs && node scripts/check-worker-bundles.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:exports",
    "prepublishOnly": "npm run verify"
  },
  "peerDependencies": {
    "maplibre-gl": ">=5.24 <7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@maplibre/maplibre-gl-style-spec": "^26.4.1",
    "@types/geojson-vt": "^3.2.5",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "maplibre-gl": "^6.6.0",
    "maplibre-gl-v5": "npm:maplibre-gl@^5.24.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "geojson-vt": "^4.0.3",
    "pbf": "^5.1.2",
    "vt-pbf": "^3.1.3"
  }
}
